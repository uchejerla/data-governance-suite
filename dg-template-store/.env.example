# Copy to .env.local for local testing. On Vercel, set these under
# Project → Settings → Environment Variables. Never commit real values.

# Stripe (Developers → API keys). Use sk_test_... until you are ready to go live.
STRIPE_SECRET_KEY=sk_test_replace_me
# Stripe (Developers → Webhooks → your endpoint → Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Signs download links. Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOWNLOAD_LINK_SECRET=replace_with_64_random_hex_characters

# Your live address, no trailing slash. Used for Stripe return pages and links in emails.
SITE_URL=https://www.your-domain.com

# Private Vercel Blob store holding the paid files and order records.
# On Vercel this is added for you when you connect the store to the project.
# You need it locally only to run scripts/upload-files.mjs.
BLOB_READ_WRITE_TOKEN=

# Optional email delivery through Resend. Leave blank to skip email;
# buyers still get their links on the page right after paying.
RESEND_API_KEY=
EMAIL_FROM=DG Template Suite <orders@your-domain.com>
SUPPORT_EMAIL=

# Optional tuning
DOWNLOAD_LINK_HOURS=72
ORDER_LOOKUP_DAYS=30

# Local development only: serve files from this folder instead of Blob. Never set on Vercel.
# LOCAL_FILES_DIR=./files
